<div class="w-full min-h-screen bg-gray-100 pt-16 px-4">
  <h3 class="text-center text-3xl font-bold text-gray-800 mb-10">
    Activity <span class="text-indigo-600"><%= @activities.count %></span>
  </h3>

  <div class="max-w-3xl mx-auto space-y-6">
    <% @activities.each do |activity| %>
      <div class="bg-[#f3f4ff] border border-[#d2d5f0] rounded-xl shadow-sm p-6 hover:shadow-md transition-shadow duration-300">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-y-3 gap-x-6 text-gray-800 text-base">
          <div><span class="font-semibold">ID:</span> <%= activity.id %></div>
          <div><span class="font-semibold">Type:</span> <%= activity.trackable_type %></div>

          <div><span class="font-semibold">Trackable ID:</span> <%= activity.trackable_id %></div>
          <div>
            <span class="font-semibold">Trackable:</span>
            <%= link_to activity.trackable, activity.trackable, class: "text-indigo-600 underline hover:text-indigo-800" %>
          </div>

          <div><span class="font-semibold">Key:</span> <%= activity.key %></div>
          <div><span class="font-semibold">Parameters:</span> <%= activity.parameters %></div>

          <div class="sm:col-span-2"><span class="font-semibold">Owner:</span> <%= activity.owner %></div>
        </div>
      </div>
    <% end %>
  </div>
</div>
