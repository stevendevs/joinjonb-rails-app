<nav class="fixed top-0 w-full bg-joinjob-yellow flex justify-between items-center h-14 px-3 z-50">
  <!-- Logo -->
  <div class="border-r border-white/40 pr-3">
    <%= link_to root_path, class: "text-2xl font-black text-white/80" do %>
      <h1>JoinJob</h1>
    <% end %>
  </div>
  

  <% if current_user %>
  <!-- SEARCH IN NAVBAR -->
  <div>
    <%= search_form_for @ransack_courses, as: :courses_search, url: courses_path do |f| %>
      <div>
        <%= f.search_field :title_cont, placeholder: 'Find a course', autocomplete: :off %>
        <%= f.submit 'Search' %>
      </div>
    <% end %>
  </div>
<% end %>


  

  <!-- Navigation -->
  <div class="flex items-center space-x-4">
 
  <div class="flex items-center  bg-yellow-500 h-10 rounded-full px-3">
    <% items = [
      ["JOINJOB", root_path],
      ["COURSES", courses_path],
      ["OPTIONS", edit_user_registration_path],
      ["USERS", users_path],
      ["MAP", explore_path],
      ["ACTIVITY", pages_activity_path]
    ].compact %>

    <%= select_tag :navigation,
        options_for_select(items, request.path),
        onchange: "Turbo.visit(this.value)",
        data: { turbo_frame: :main }
    %>

  </div>
  <div> 

  <!-- User Actions -->
  <% if user_signed_in? %>
    <%= link_to 'Sign out',
                destroy_user_session_path,
                data: { turbo_method: :delete },
                class: "text-white bg-red-700 hover:bg-red-800 rounded-complete font-medium radius-5xl text-sm px-5 py-2.5 text-center me-2 mb-2 dark:bg-red-600 dark:hover:bg-red-700 " %>             
  <% end %>

  </div>
  </div>
</nav>




