<div id="<%= dom_id lesson %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <% if policy(lesson).show? %>
      <%= link_to lesson.title, course_lesson_path(@course, lesson), class: "underline hover:text-gray-600 inline-block font-medium cursor-pointer" %>
    <% else %>
      <span class="inline-block font-medium text-gray-500 cursor-not-allowed"><%= lesson.title %></span>
    <% end %>
  </div>

  <div>
    <strong class="block font-medium mb-1">Content:</strong>
    <%= lesson.content %>
  </div>

  <div>
    <strong class="block font-medium mb-1">Course:</strong>
    <%= lesson.course.title if lesson.course %>
  </div>

  <% if policy(lesson).edit? %>
    <div class="w-full sm:w-auto flex flex-col sm:flex-row space-x-2 space-y-2">
      <%= link_to "Edit", edit_course_lesson_path(@course, lesson), class: "w-full sm:w-auto text-center rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>
      <%= button_to "Destroy", [@course, lesson], method: :delete, class: "w-full sm:w-auto rounded-md px-3.5 py-2.5 text-white bg-red-600 hover:bg-red-500 font-medium cursor-pointer", data: { turbo_confirm: "Are you sure?" } %>
    </div>
  <% end %>
</div>
